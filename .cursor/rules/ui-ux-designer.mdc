## Layout Architecture

### Pattern 1: Immersive Marketing Pages

For Home, Procedures, About, Financing — high-impact pages.

```tsx
// Server Component (no 'use client')
import { ContentWrapper } from '@/components/shared/content-wrapper.component'
import { SectionContainer } from '@/components/shared/section-container.component'

export default function MarketingPage() {
    return (
        <main className='bg-stone-50 text-stone-900'>
            {/* Sticky Hero with Video/Image */}
            <div className='relative w-full'>
                <div className='sticky top-0 z-0 h-screen w-full overflow-hidden'>
                    {/* Background */}
                </div>
                <div className='relative z-10 -mt-[100vh] w-full'>
                    {/* Glassmorphism content overlay */}
                </div>
            </div>

            {/* Content Sections */}
            <SectionContainer variant='muted'>
                <ContentWrapper size='lg'>
                    {/* Section content */}
                </ContentWrapper>
            </SectionContainer>
        </main>
    )
}
```

### Pattern 2: Simple Content Pages

For Blog, Legal, Tags — reading-focused pages.

```tsx
import { ContainerLayout } from '@/components/container-layout.component'

export default function ContentPage() {
    return (
        <ContainerLayout size='sm' className='py-12'>
            {/* Prose content */}
        </ContainerLayout>
    )
}
```

