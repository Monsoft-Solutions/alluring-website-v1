# Admin Dashboard Environment Variables
# Copy this file to .env.local and fill in the values

# Database - same as main website
POSTGRES_URL=postgresql://user:password@localhost:5432/database

# Better-Auth configuration
# Base URL for auth endpoints (should match your admin app URL)
BETTER_AUTH_URL=http://localhost:3105
# Session signing secret - generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-32-char-minimum-secret-here

# Email configuration (Resend) - for invitation emails
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=admin@yourdomain.com

# Public web app URL - for building absolute links to live pages
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Vercel Blob storage for media uploads
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# Cache revalidation secret - must match the web app's REVALIDATION_SECRET
# Generate with: openssl rand -base64 32
REVALIDATION_SECRET=your-32-char-minimum-secret-here

# fal.ai API key (required for AI image generation)
FAL_KEY=fal_xxxxx

# OpenAI API key (optional, for testing chat in admin)
# OPENAI_API_KEY=sk-xxxxx

# Langfuse Observability (optional - for AI tracing)
# Sign up at https://langfuse.com to get these keys
# LANGFUSE_SECRET_KEY=sk-lf-xxxxx
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxx
# LANGFUSE_BASE_URL=https://cloud.langfuse.com  # EU region
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com  # US region
# LANGFUSE_ENABLED=true

# Google Search Console API (optional - for SEO insights)
# Use same service account as Google Indexing API
# 1. Enable Search Console API in Google Cloud Console
# 2. Add service account email to Search Console property with Full access
# GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Site URL format depends on your Search Console property type:
# - Domain property (covers all subdomains/protocols): sc-domain:example.com
# - URL-prefix property: https://example.com
# GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:example.com

# Admin seed variables (for initial setup only)
# Run `pnpm db:seed` in packages/db to create the first admin user
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=your-secure-password
# ADMIN_NAME=Admin
