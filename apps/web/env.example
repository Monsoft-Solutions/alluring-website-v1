# Web App Environment Variables
# Copy this file to .env.local and fill in the values
# Most site/business data is centralized in lib/data/site-config.ts

# ==============================================================================
# Required Server Variables
# ==============================================================================

# Database
POSTGRES_URL=postgresql://user:password@localhost:5432/database

# Blog API authentication
BLOG_API_KEY=your-blog-api-key

# Email (Resend)
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
OWNER_EMAIL=owner@yourdomain.com

# Cache revalidation secret - must match the admin app's REVALIDATION_SECRET
# Generate with: openssl rand -base64 32
REVALIDATION_SECRET=your-32-char-minimum-secret-here

# ==============================================================================
# Optional Server Variables
# ==============================================================================

# Vercel Blob storage (optional, for image uploads)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# OpenAI API key (required for chat agent)
# OPENAI_API_KEY=sk-xxxxx

# ElevenLabs Speech-to-Text (optional - enables voice input in chat)
# Sign up at https://elevenlabs.io to get an API key
# ELEVENLABS_API_KEY=sk_xxxxx

# Langfuse Observability (optional - for AI tracing)
# Sign up at https://langfuse.com to get these keys
# LANGFUSE_SECRET_KEY=sk-lf-xxxxx
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxx
# LANGFUSE_BASE_URL=https://cloud.langfuse.com  # EU region
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com  # US region
# LANGFUSE_ENABLED=true

# ==============================================================================
# Optional Client Variables (defaults in site-config.ts)
# ==============================================================================

# Site URL (falls back to VERCEL_URL in production)
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Analytics (all optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxx
# NEXT_PUBLIC_GTM_ID=GTM-XXXXX
# NEXT_PUBLIC_FACEBOOK_PIXEL_ID=xxxxx

# Feature flags
# NEXT_PUBLIC_ENABLE_MOBILE_CALL_BUTTON=true
# NEXT_PUBLIC_ALLOW_CRAWLING=true
# NEXT_PUBLIC_BETA_MODE=false
# NEXT_PUBLIC_CHAT_ENABLED=true
# NEXT_PUBLIC_ENABLE_COOKIE_BANNER=true

