        "claims": [
            {
                "code": "abps",
                "severity": "error",
                "pattern": "\\babps\\b|american board of plastic surgery",
                "why": "She is not certified by the American Board of Plastic Surgery."
            },
            {
                "code": "board-certified-plastic-surgeon",
                "severity": "error",
                "pattern": "board[\\s-]certified (?:cosmetic and )?plastic surgeons?",
                "why": "Never 'board-certified plastic surgeon'."
            },
            {
                "code": "double-board",
                "severity": "error",
                "pattern": "(?:double|triple|dual)[\\s-]board",
                "why": "Never 'double/triple board-certified'."
            },
            {
                "code": "volume-claim",
                "severity": "error",
                "pattern": "\\b\\d{1,2},?\\d{3}\\+? (?:\\w+ )?(?:procedures|patients|surgeries|cases)|thousands of (?:patients|procedures|surgeries)|\\b5,?000\\+",
                "why": "No '5,000+' or volume claims."
            },
            {
                "code": "tenure-claim",
                "severity": "error",
                "pattern": "\\b\\d{1,2}\\+ ?years|(?:over|more than) \\d{1,2} years (?:of )?(?:experience|in practice)",
                "why": "No '15+ years' or tenure claims."
            },
            {
                "code": "accreditation",
                "severity": "error",
                "pattern": "aaaasf|\\baccredited\\b|accreditation",
                "why": "Facility accreditation is unverified; never AAAASF."
            },
            {
                "code": "multiple-surgeons",
                "severity": "error",
                "pattern": "\\b(?:our|its|their|the practice'?s|alluring'?s) (?:board[\\s-]certified )?surgeons\\b|surgeons at alluring|team of (?:\\w+ )?surgeons",
                "why": "One surgeon: Victoria Karlinsky, MD, FACS."
            },
