        "prices": {
            "_note": "Amounts in whole dollars that Alluring may be quoted at, per procedure. 'retired' are old figures that must never come back. An amount in neither list is reported as price-unverified (warn). Edit this block when the price sheet changes.",
            "bbl": {
                "match": "\\bbbl\\b|brazilian butt|butt lift|lipo ?360 ?\\+ ?bbl",
                "allowed": [5500, 10000],
                "retired": [3500, 4500, 3000]
            },
            "mommy-makeover": {
                "match": "mommy make ?over|mommy makeover",
                "allowed": [
                    500, 1000, 3000, 3500, 4000, 4500, 5000, 5500, 6000, 7000
                ],
                "retired": [],
