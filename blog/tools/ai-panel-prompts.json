            },
            "tummy-tuck": {
                "match": "tummy tuck|abdominoplast|abdominoplastia",
                "allowed": [3000, 4000, 4500, 5500, 10000, 1500],
                "retired": [3500, 6500, 8000],
                "note": "mini $3,000, extended mini $4,000, regular/full $4,500, extended $5,500, fleur-de-lis $10,000; lipo add-on $1,500."
            },
            "lipo": {
                "match": "lipo ?360|liposuc|\\blipo\\b|liposucci",
                "allowed": [4000, 500, 1000, 1500],
                "retired": [2500, 4500, 3000, 5000],
                "note": "Lipo 360 from $4,000; add-on areas $500-$1,500."
            },
            "breast-lift": {
                "match": "breast lift|mastopexy|levantamiento de senos",
