{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**", "dist/**"],
            "env": [
                "NODE_ENV",
                "POSTGRES_URL",
                "POSTGRES_URL_PROD",
                "ADMIN_PASSWORD",
                "BLOG_API_KEY",
                "BLOB_READ_WRITE_TOKEN",
                "VERCEL_URL",
                "RESEND_API_KEY",
                "RESEND_FROM_EMAIL",
                "OWNER_EMAIL",
                "REVALIDATION_SECRET",
                "CRON_SECRET",
                "LANGFUSE_SECRET_KEY",
                "LANGFUSE_PUBLIC_KEY",
                "LANGFUSE_BASE_URL",
                "LANGFUSE_ENABLED",
                "NEXT_PUBLIC_SITE_URL",
                "NEXT_PUBLIC_SITE_NAME",
                "NEXT_PUBLIC_SITE_DESCRIPTION",
                "NEXT_PUBLIC_TWITTER_HANDLE",
                "NEXT_PUBLIC_FACEBOOK_APP_ID",
                "NEXT_PUBLIC_LOCALE",
                "NEXT_PUBLIC_ENABLE_INDEXING",
                "NEXT_PUBLIC_GA_MEASUREMENT_ID",
                "NEXT_PUBLIC_CLARITY_PROJECT_ID",
                "NEXT_PUBLIC_GTM_ID",
                "NEXT_PUBLIC_FACEBOOK_PIXEL_ID",
                "NEXT_PUBLIC_ENABLE_MOBILE_CALL_BUTTON",
                "NEXT_PUBLIC_WEB_URL",
                "NEXT_PUBLIC_ALLOW_CRAWLING",
                "NEXT_PUBLIC_BETA_MODE",
                "NEXT_PUBLIC_CHAT_ENABLED",
                "AUTH_SECRET",
                "GOOGLE_CLIENT_EMAIL",
                "GOOGLE_PRIVATE_KEY",
                "GOOGLE_SEARCH_CONSOLE_SITE_URL",
                "GOOGLE_BUSINESS_CLIENT_ID",
                "GOOGLE_BUSINESS_CLIENT_SECRET",
                "GOOGLE_BUSINESS_REDIRECT_URI",
                "NEXUITE_CRM_API_URL",
                "FAL_KEY",
                "TAVILY_API_KEY",
                "GOOGLE_CUSTOM_SEARCH_API_KEY",
                "GOOGLE_CUSTOM_SEARCH_ENGINE_ID",
                "PERPLEXITY_API_KEY",
                "OPENROUTER_API_KEY",
                "SEED_CLEAR_BLOG",
                "N8N_WEBHOOK_URL"
            ]
        },
        "analyze": {
            "dependsOn": ["^build"],
            "cache": false,
            "outputs": [],
            "passThroughEnv": ["*"]
        },
        "lint": {
            "dependsOn": ["^build"]
        },
        "format": {
            "dependsOn": ["^format"],
            "outputs": [],
            "cache": false
        },
        "typecheck": {
            "dependsOn": ["^build"],
            "outputs": ["*.tsbuildinfo"]
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": [],
            "env": ["OPENROUTER_LIVE"]
        },
        "check-types": {
            "dependsOn": ["^check-types"]
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "env": [
                "NODE_ENV",
                "POSTGRES_URL",
                "POSTGRES_URL_PROD",
                "ADMIN_PASSWORD",
                "BLOG_API_KEY",
                "BLOB_READ_WRITE_TOKEN",
                "VERCEL_URL",
                "RESEND_API_KEY",
                "RESEND_FROM_EMAIL",
                "OWNER_EMAIL",
                "REVALIDATION_SECRET",
                "CRON_SECRET",
                "LANGFUSE_SECRET_KEY",
                "LANGFUSE_PUBLIC_KEY",
                "LANGFUSE_BASE_URL",
                "LANGFUSE_ENABLED",
                "NEXT_PUBLIC_SITE_URL",
                "NEXT_PUBLIC_SITE_NAME",
                "NEXT_PUBLIC_SITE_DESCRIPTION",
                "NEXT_PUBLIC_TWITTER_HANDLE",
                "NEXT_PUBLIC_FACEBOOK_APP_ID",
                "NEXT_PUBLIC_LOCALE",
                "NEXT_PUBLIC_ENABLE_INDEXING",
                "NEXT_PUBLIC_GA_MEASUREMENT_ID",
                "NEXT_PUBLIC_CLARITY_PROJECT_ID",
                "NEXT_PUBLIC_GTM_ID",
                "NEXT_PUBLIC_FACEBOOK_PIXEL_ID",
                "NEXT_PUBLIC_ENABLE_MOBILE_CALL_BUTTON",
                "NEXT_PUBLIC_WEB_URL",
                "NEXT_PUBLIC_ALLOW_CRAWLING",
                "NEXT_PUBLIC_BETA_MODE",
                "NEXT_PUBLIC_CHAT_ENABLED",
                "AUTH_SECRET",
                "GOOGLE_CLIENT_EMAIL",
                "GOOGLE_PRIVATE_KEY",
                "GOOGLE_SEARCH_CONSOLE_SITE_URL",
                "GOOGLE_BUSINESS_CLIENT_ID",
                "GOOGLE_BUSINESS_CLIENT_SECRET",
                "GOOGLE_BUSINESS_REDIRECT_URI",
                "NEXUITE_CRM_API_URL",
                "FAL_KEY",
                "TAVILY_API_KEY",
                "GOOGLE_CUSTOM_SEARCH_API_KEY",
                "GOOGLE_CUSTOM_SEARCH_ENGINE_ID",
                "PERPLEXITY_API_KEY",
                "OPENROUTER_API_KEY",
                "SEED_CLEAR_BLOG",
                "N8N_WEBHOOK_URL",
                "WEB_PORT",
                "ADMIN_PORT"
            ]
        },
        "db:generate": {
            "cache": false,
            "outputs": ["migrations/**"]
        },
        "db:migrate": {
            "cache": false,
            "outputs": [],
            "env": ["POSTGRES_URL"]
        },
        "db:migrate:prod": {
            "cache": false,
            "interactive": true,
            "outputs": [],
            "env": ["POSTGRES_URL_PROD"]
        },
        "db:check": {
            "cache": false,
            "outputs": [],
            "env": ["POSTGRES_URL"]
        },
        "db:check:prod": {
            "cache": false,
            "outputs": [],
            "env": ["POSTGRES_URL_PROD"]
        },
        "db:baseline": {
            "cache": false,
            "interactive": true,
            "outputs": []
        },
        "db:baseline:prod": {
            "cache": false,
            "interactive": true,
            "outputs": []
        },
        "db:push": {
            "cache": false,
            "outputs": []
        },
        "db:studio": {
            "cache": false,
            "persistent": true
        },
        "db:seed": {
            "cache": false,
            "outputs": []
        }
    }
}
