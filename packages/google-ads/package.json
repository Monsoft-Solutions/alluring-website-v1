{
    "name": "@workspace/google-ads",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "lint": "eslint . --ext .ts",
        "typecheck": "tsc --noEmit",
