        "test:watch": "vitest",
        "format": "pnpm -w format"
    },
    "dependencies": {
        "google-auth-library": "^10.5.0",
        "zod": "^4.3.5"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "@workspace/eslint-config": "workspace:*",
        "@workspace/typescript-config": "workspace:*",
        "typescript": "^5.9.3",
        "vitest": "^4.1.5"
    }
