# Database connection strings
#
# Every db:* command names the database it targets (issue #186).
#   POSTGRES_URL       the default for db:migrate, db:push, db:seed, db:studio
#   POSTGRES_URL_PROD  reached only by the :prod command variants

# Must be a localhost database — the commands refuse a remote host here, so
# that db:seed and db:push cannot reach production by misconfiguration.
POSTGRES_URL="postgresql://user:password@localhost:5432/dbname"

# Optional. Production: PgBouncer on ovh_24, SESSION pool (database
# alluring_session) — migrations cannot run over the transaction pool
# (database alluring) and the command will refuse it.
# POSTGRES_URL_PROD="postgresql://alluring:password@15.204.231.178:25432/alluring_session?sslmode=require"
