{
    "name": "@workspace/db",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "types": "./dist/client.d.ts",
    "exports": {
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js",
            "default": "./dist/client.js"
        },
        "./schema/analytics": {
            "types": "./dist/schema/analytics/index.d.ts",
            "import": "./dist/schema/analytics/index.js",
            "default": "./dist/schema/analytics/index.js"
        },
        "./schema/blog": {
            "types": "./dist/schema/blog/index.d.ts",
            "import": "./dist/schema/blog/index.js",
            "default": "./dist/schema/blog/index.js"
        },
        "./schema/chat": {
            "types": "./dist/schema/chat/index.d.ts",
            "import": "./dist/schema/chat/index.js",
            "default": "./dist/schema/chat/index.js"
        },
        "./schema/contact": {
            "types": "./dist/schema/contact/index.d.ts",
            "import": "./dist/schema/contact/index.js",
            "default": "./dist/schema/contact/index.js"
        },
        "./schema/emails": {
            "types": "./dist/schema/emails/index.d.ts",
            "import": "./dist/schema/emails/index.js",
            "default": "./dist/schema/emails/index.js"
        },
        "./schema/feedback": {
            "types": "./dist/schema/feedback/index.d.ts",
            "import": "./dist/schema/feedback/index.js",
            "default": "./dist/schema/feedback/index.js"
        },
        "./schema/gallery": {
            "types": "./dist/schema/gallery/index.d.ts",
            "import": "./dist/schema/gallery/index.js",
            "default": "./dist/schema/gallery/index.js"
        },
        "./types": {
            "types": "./dist/schema/contact/contact-submission.table.d.ts",
            "import": "./dist/schema/contact/contact-submission.table.js",
            "default": "./dist/schema/contact/contact-submission.table.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx src/migrate.ts",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "db:seed": "tsx src/seed/index.ts",
        "lint": "eslint . --max-warnings 0",
        "format": "pnpm -w format"
    },
    "dependencies": {
        "@t3-oss/env-core": "^0.13.8",
        "drizzle-orm": "^0.44.7",
        "glob": "^13.0.0",
        "lodash": "^4.17.21",
        "postgres": "^3.4.7",
        "zod": "^4.1.13"
    },
    "devDependencies": {
        "@faker-js/faker": "^10.1.0",
        "@types/lodash": "^4.17.21",
        "@workspace/eslint-config": "workspace:*",
        "@workspace/typescript-config": "workspace:*",
        "dotenv": "^17.2.3",
        "drizzle-kit": "^0.31.7",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    }
}
