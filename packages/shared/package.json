{
    "name": "@workspace/shared",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./cache": {
            "types": "./dist/cache/index.d.ts",
            "import": "./dist/cache/index.js",
            "default": "./dist/cache/index.js"
        },
        "./schemas/gallery": {
            "types": "./dist/schemas/gallery/index.d.ts",
            "import": "./dist/schemas/gallery/index.js",
            "default": "./dist/schemas/gallery/index.js"
        },
        "./schemas/chat": {
            "types": "./dist/schemas/chat/index.d.ts",
            "import": "./dist/schemas/chat/index.js",
            "default": "./dist/schemas/chat/index.js"
        },
        "./schemas/text": {
            "types": "./dist/schemas/text/index.d.ts",
            "import": "./dist/schemas/text/index.js",
            "default": "./dist/schemas/text/index.js"
        },
        "./schemas/analysis": {
            "types": "./dist/schemas/analysis/index.d.ts",
            "import": "./dist/schemas/analysis/index.js",
            "default": "./dist/schemas/analysis/index.js"
        },
        "./schemas/blog": {
            "types": "./dist/schemas/blog/index.d.ts",
            "import": "./dist/schemas/blog/index.js",
            "default": "./dist/schemas/blog/index.js"
        },
        "./schemas/seo": {
            "types": "./dist/schemas/seo/index.d.ts",
            "import": "./dist/schemas/seo/index.js",
            "default": "./dist/schemas/seo/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "lint": "eslint . --ext .ts,.tsx",
        "typecheck": "tsc --noEmit",
        "format": "pnpm -w format"
    },
    "dependencies": {
        "zod": "^4.3.5"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "@workspace/eslint-config": "workspace:*",
        "@workspace/typescript-config": "workspace:*",
        "typescript": "^5.9.3"
    }
}
