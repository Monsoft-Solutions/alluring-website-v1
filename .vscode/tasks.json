{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Next.js Dev Server (Debug)",
            "type": "shell",
            "command": "pnpm",
            "args": [
                "--filter",
                "admin",
                "dev:debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false
            },
            "runOptions": {
                "runOn": "default"
            }
        }
    ]
}

