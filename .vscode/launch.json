{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to Next.js Server",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "restart": true,
            "skipFiles": [
                "<node_internals>/**"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "sourceMaps": true,
            "cwd": "${workspaceFolder}/apps/admin",
            "env": {
                "NODE_ENV": "development"
            }
        },
        {
            "name": "Launch Next.js with Debugging",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "--filter",
                "admin",
                "dev:debug"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ],
            "sourceMaps": true,
            "cwd": "${workspaceFolder}/apps/admin",
            "env": {
                "NODE_ENV": "development"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "serverReadyAction": {
                "pattern": "Ready in [0-9]+ms",
                "uriFormat": "http://localhost:3105",
                "action": "openExternally"
            }
        }
    ]
}

